{
  "name": "inventory-system",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm --filter @inventory/server start",
    "db:migrate": "pnpm --filter @inventory/server exec prisma migrate dev",
    "db:push": "pnpm --filter @inventory/server exec prisma db push",
    "db:generate": "pnpm --filter @inventory/server exec prisma generate",
    "db:seed": "pnpm --filter @inventory/server exec prisma db seed",
    "db:studio": "pnpm --filter @inventory/server exec prisma studio",
    "reservation:check": "pnpm --filter @inventory/server run reservation:concurrency-check",
    "reservation:expiry-check": "pnpm --filter @inventory/server run reservation:expiry-check",
    "reservation:purchase-check": "pnpm --filter @inventory/server run reservation:purchase-check",
    "drop-feed:check": "pnpm --filter @inventory/server run drop-feed:check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
