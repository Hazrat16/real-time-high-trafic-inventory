# Production environment for docker-compose.prod.yml.
# Upload this (filled in) to Jenkins as a "Secret file" credential with ID: inventory-prod-env
# Use only letters and digits in the password (it is embedded in DATABASE_URL).
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=inventory

# Public URL users open in the browser (http://<EC2_PUBLIC_IP> or https://your-domain)
CLIENT_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Seed demo users (alice/bob/carol) + a sample drop on startup. Idempotent.
RUN_SEED=true

# Host port nginx listens on
WEB_PORT=80
